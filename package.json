{
  "name": "spmb-fila",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20.19 <25"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:auth-integration": "tsx scripts/verify-auth-profile.ts",
    "test:phase3-integration": "tsx scripts/verify-phase3.ts",
    "test:phase4-integration": "tsx scripts/verify-phase4.ts",
    "test:phase5-integration": "tsx scripts/verify-phase5.ts",
    "test:dynamic-payment-integration": "tsx scripts/verify-dynamic-registration-payment.ts",
    "test:phase6-integration": "tsx scripts/verify-phase6.ts",
    "test:phase7-integration": "tsx scripts/verify-phase7.ts",
    "test:phase8-integration": "tsx scripts/verify-phase8.ts",
    "test:phase9-integration": "tsx scripts/verify-phase9.ts",
    "test:phase10-integration": "tsx scripts/verify-phase10.ts",
    "test:final-route-choice-integration": "tsx scripts/verify-final-route-choice.ts",
    "test:admin-deletion-integration": "tsx scripts/verify-admin-deletion.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:integration": "node scripts/run-phase11.mjs --integration-only",
    "test:phase11": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/run-phase11.mjs",
    "auth:set-admin": "tsx scripts/set-admin.ts",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:verify-migration": "node prisma/verify-migration.mjs",
    "storage:ensure-buckets": "tsx scripts/ensure-storage-buckets.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
