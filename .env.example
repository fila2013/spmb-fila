# Salin file ini menjadi .env.local. Jangan masukkan nilai production ke Git.

# Supabase Auth dan Data API (aman digunakan client dengan RLS yang benar)
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key

# Supabase server-only
SUPABASE_SECRET_KEY=replace-with-staging-secret-key
# Nama legacy berikut tetap didukung sebagai fallback. Isi salah satu saja.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key

# Prisma: pooled untuk runtime, direct untuk migration
DATABASE_URL=postgresql://postgres:change-me@pooler.example.invalid:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:change-me@db.example.invalid:5432/postgres

# Supabase Storage
SUPABASE_STORAGE_BUCKET_PEMBAYARAN=bukti-pembayaran
SUPABASE_STORAGE_BUCKET_CMS=konten-cms

# Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Midtrans. Development/Preview harus menggunakan sandbox dan false.
MIDTRANS_MERCHANT_ID=replace-with-sandbox-merchant-id
MIDTRANS_SERVER_KEY=replace-with-sandbox-server-key
MIDTRANS_CLIENT_KEY=replace-with-sandbox-client-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=replace-with-sandbox-client-key
MIDTRANS_IS_PRODUCTION=false
# Isi dengan endpoint HTTPS Preview untuk webhook Sandbox nyata.
# MIDTRANS_NOTIFICATION_URL=https://preview.example.com/api/webhooks/midtrans
